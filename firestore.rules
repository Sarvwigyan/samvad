rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles (Parichay) — फ़ॉलोअर्स और प्रोफ़ाइल फ़ोटो बिना रुकावट सेव होंगे
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(userId);
      allow update: if isAuthenticated();
      allow delete: if false;

      // Subcollection: Followers
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isOwner(followerId) || (isAuthenticated() && request.auth.uid == userId);
      }

      // Subcollection: Following
      match /following/{followingId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Subcollection: Bookmarks (Smaran)
      match /bookmarks/{postId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Subcollection: Likes
      match /likes/{postId} {
        allow read: if true;
        allow write, delete: if isOwner(userId);
      }

      // Subcollection: Notifications (Soochna & @Mentions)
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // Posts (Vichar)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        resource.data.preserve == false
      );

      // Subcollection: Likes (Anumodan)
      match /likes/{userId} {
        allow read: if true;
        allow write, delete: if isOwner(userId);
      }

      // Subcollection: Reposts (Prasar)
      match /reposts/{userId} {
        allow read: if true;
        allow write, delete: if isOwner(userId);
      }

      // Subcollection: Replies (Uttar)
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if false;
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
      }
    }

    // System Control Documents (Auto-pruning lock)
    match /system/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Backward Compatibility for Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Direct Messages (Sandesh) — 1:1 संवाद
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
